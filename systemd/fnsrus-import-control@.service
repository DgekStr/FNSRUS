[Unit]
Description=FNSRUS OpenSanctions import control request

[Service]
Type=exec
User=root
Group=root
StandardInput=socket
StandardOutput=socket
ExecStart=/usr/bin/python3 /usr/local/libexec/fnsrus-import-control
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run